# Local pipeline: all optional.
RESOLVE_DATA=            # default: data/
RESOLVE_OUTPUT=          # default: output/
# Optional LLM planner (python run_pipeline.py --llm): any OpenAI-compatible chat API, e.g. a local Ollama server
LLM_BASE_URL=            # e.g. http://127.0.0.1:11434/v1
LLM_MODEL=               # a model that accepts images, e.g. a vision model served by Ollama
LLM_API_KEY=
# download_data.py: a Kaggle API token (or ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
# Cloud version (cloud/): your own project; nothing here is committed
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
GEMINI_MODEL=gemini-2.5-flash-lite
