{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool Registry v1",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "parameters"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "parameters": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "properties": { "type": "object" },
              "required": { "type": "array", "items": { "type": "string" } }
            }
          },
          "safety_level": { 
            "type": "string", 
            "enum": ["low", "medium", "high", "critical"] 
          }
        }
      }
    }
  },
  "default": {
    "tools": [
      {
        "id": "emergency_stop",
        "name": "Emergency Stop",
        "description": "Immediately stops all conveyor operations",
        "parameters": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "zone": { "type": "string" }
          },
          "required": ["reason"]
        },
        "safety_level": "critical"
      },
      {
        "id": "reduce_speed",
        "name": "Reduce Conveyor Speed",
        "description": "Reduces conveyor speed by specified percentage",
        "parameters": {
          "type": "object",
          "properties": {
            "reduction_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "zone": { "type": "string" }
          },
          "required": ["reduction_percent"]
        },
        "safety_level": "medium"
      },
      {
        "id": "alert_maintenance",
        "name": "Alert Maintenance Team",
        "description": "Sends alert to maintenance team for inspection",
        "parameters": {
          "type": "object",
          "properties": {
            "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
            "description": { "type": "string" },
            "equipment_id": { "type": "string" }
          },
          "required": ["priority", "description"]
        },
        "safety_level": "low"
      },
      {
        "id": "log_incident",
        "name": "Log Incident",
        "description": "Records incident in maintenance log",
        "parameters": {
          "type": "object",
          "properties": {
            "incident_type": { "type": "string" },
            "severity": { "type": "string", "enum": ["minor", "moderate", "major", "critical"] },
            "description": { "type": "string" },
            "telemetry_snapshot": { "type": "object" }
          },
          "required": ["incident_type", "severity", "description"]
        },
        "safety_level": "low"
      }
    ]
  }
}
