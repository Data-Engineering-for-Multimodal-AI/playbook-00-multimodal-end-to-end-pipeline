{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thermal Metadata v1",
  "type": "object",
  "required": ["ts", "session_id", "thermal_uri"],
  "properties": {
    "ts": { 
      "type": "string", 
      "format": "date-time",
      "description": "Event timestamp in ISO8601 UTC"
    },
    "session_id": { 
      "type": "string",
      "description": "Pipeline session identifier"
    },
    "thermal_uri": {
      "type": "string",
      "pattern": "^gs://.*",
      "description": "GCS URI to thermal image"
    },
    "annotation": {
      "type": "string",
      "description": "Optional annotation for thermal data (e.g., 'shadow')"
    }
  }
}
