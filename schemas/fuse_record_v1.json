{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audio Metadata v1",
  "type": "object",
  "required": ["ts", "session_id", "audio_uri", "transcript_uri"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "session_id": { "type": "string" },
    "audio_uri": {
      "type": "string",
      "pattern": "^gs://.*",
      "description": "GCS URI to WAV file"
    },
    "transcript_uri": {
      "type": "string",
      "pattern": "^gs://.*",
      "description": "GCS URI to transcript .txt"
    },
    "duration_sec": { "type": "number", "minimum": 0.1, "maximum": 60 }
  }
}
