{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telemetry Record v1",
  "type": "object",
  "required": ["ts", "session_id", "machine_id", "features"],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp in ISO8601 UTC"
    },
    "session_id": {
      "type": "string",
      "description": "Pipeline session identifier"
    },
    "machine_id": {
      "type": "string",
      "description": "Unique ID of the machine"
    },
    "features": {
      "type": "object",
      "required": ["temperature_c", "vibration_rms", "rpm", "torque_nm"],
      "properties": {
        "temperature_c": { "type": "number", "minimum": -40, "maximum": 150 },
        "vibration_rms": { "type": "number", "minimum": 0, "maximum": 10 },
        "rpm": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "torque_nm": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "label": {
      "type": "string",
      "enum": ["normal", "anomaly"]
    }
  }
}
