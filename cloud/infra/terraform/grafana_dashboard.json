{
  "dashboard": {
    "id": null,
    "title": "Resolve Agent Pipeline",
    "tags": ["resolve-agent", "multimodal", "industrial"],
    "timezone": "UTC",
    "panels": [
      {
        "id": 1,
        "title": "Message Publish Rates by Lane",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(edge_publisher_messages_published_total[5m])",
            "legendFormat": "{{topic}} - Published",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Messages/sec",
            "min": 0
          }
        ],
        "legend": {
          "show": true,
          "values": false,
          "min": false,
          "max": false,
          "current": false,
          "total": false,
          "avg": false
        }
      },
      {
        "id": 2,
        "title": "Schema Validation Rejects",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(edge_publisher_messages_rejected_total[5m])",
            "legendFormat": "{{reason}} - Rejected",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Rejects/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 3,
        "title": "Fusion Pipeline Late Arrivals",
        "type": "singlestat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(dataflow_late_data_total[5m]) / rate(dataflow_total_elements[5m]) * 100",
            "refId": "A"
          }
        ],
        "valueName": "current",
        "format": "percent",
        "thresholds": "10,25"
      },
      {
        "id": 4,
        "title": "Fused Records Emitted",
        "type": "singlestat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
        "targets": [
          {
            "expr": "rate(fusion_fused_records_emitted_total[5m])",
            "refId": "A"
          }
        ],
        "valueName": "current",
        "format": "ops",
        "sparkline": {
          "show": true
        }
      },
      {
        "id": 5,
        "title": "Planner Latency P95",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(planner_latency_seconds_bucket[5m]))",
            "legendFormat": "P95 Latency",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(planner_latency_seconds_bucket[5m]))",
            "legendFormat": "P50 Latency",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds",
            "min": 0
          }
        ]
      },
      {
        "id": 6,
        "title": "Action Execution Status",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(action_agent_actions_executed_total[5m])",
            "legendFormat": "{{tool_id}} - Executed",
            "refId": "A"
          },
          {
            "expr": "rate(action_agent_actions_blocked_total[5m])",
            "legendFormat": "{{reason}} - Blocked",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Actions/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 7,
        "title": "Safety Policy Violations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "rate(policy_violations_total[5m])",
            "legendFormat": "{{tool_id}} - {{risk_level}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Violations/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 8,
        "title": "BigQuery Write Success Rate",
        "type": "singlestat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(bigquery_writes_success_total[5m]) / rate(bigquery_writes_total[5m]) * 100",
            "refId": "A"
          }
        ],
        "valueName": "current",
        "format": "percent",
        "thresholds": "95,99",
        "colorBackground": true
      },
      {
        "id": 9,
        "title": "KB Document Retrieval Success",
        "type": "singlestat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 24},
        "targets": [
          {
            "expr": "rate(planner_kb_retrievals_total{status=\"success\"}[5m]) / rate(planner_kb_retrievals_total[5m]) * 100",
            "refId": "A"
          }
        ],
        "valueName": "current",
        "format": "percent",
        "thresholds": "90,95"
      },
      {
        "id": 10,
        "title": "Cloud Run Service Health",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "up{job=~\".*cloud-run.*\"}",
            "format": "table",
            "refId": "A"
          }
        ],
        "columns": [
          {"text": "Service", "value": "job"},
          {"text": "Status", "value": "Value"},
          {"text": "Region", "value": "region"}
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 1,
    "links": []
  }
}
